# Copy this file to ".env" and fill in the values. Never commit .env.

# Where contact-form messages are delivered
CONTACT_TO=manishratancollege@gmail.com

# Gmail SMTP: SMTP_USER is the Gmail address that sends the mail.
# SMTP_PASS must be a Gmail *App Password* (not your normal password):
#   Google Account → Security → 2-Step Verification (turn on) → App passwords → create one.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=manishratan17@gmail.com
SMTP_PASS=zxna ybsn ufra enqi

PORT=3000
# NODE_ENV=production

# Only needed if the website is hosted on a different domain than this server,
# e.g. ALLOWED_ORIGINS=https://manishratan.netlify.app
ALLOWED_ORIGINS=

# Set to 1 when running behind a proxy/host (Render, Railway, Nginx) so rate limiting sees real IPs
TRUST_PROXY=1

# Max contact messages per IP per 15 minutes
RATE_LIMIT_MAX=5
